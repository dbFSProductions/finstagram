  "cards": [
    {
      "id": "xerra",
      "name": "Xerra",
      "emoji": "🗣️",
      "gradient": [
        "#da121a",
        "#f6b21b"
      ],
      "url": "https://dbfsproductions.github.io/listen-record-learn/",
      "cta": "Practise now",
      "messages": [
        {
          "title": "Cinc minuts de català?",
          "text": "Five minutes. One deck, a handful of phrases, A/B playback. Your weakest word is waiting in Xerra."
        },
        {
          "title": "Which word did you skip last time?",
          "text": "Xerra scores your weakest word, not your average. Go and find it."
        },
        {
          "title": "Road mode on the walk?",
          "text": "Listen and repeat with nothing to read. Xerra's road mode fits in a walk to the shops."
        },
        {
          "title": "Level 2 is calling",
          "text": "The phrases you've said well four times are waiting to be recalled from memory. Recall is what makes them stick."
        },
        {
          "title": "Bon dia. Say it out loud.",
          "text": "Record it, hear the model, hear yourself. The gap between the two is the lesson."
        },
        {
          "title": "The starred phrases need a run",
          "text": "Favourites are the phrases you said you needed more of. Drill them before the feed drills you."
        }
      ]
    }
  ],
